      "targets": [
        {
          "dataset": "LOOTS",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "P7D58F15E2B4BC203"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  a.reading_date AS time,\n  ROUND(\n    ((a.cumulative_electricity_used - b.cumulative_electricity_used)\n    / NULLIF(EXTRACT(EPOCH FROM (a.reading_date - b.reading_date)) / 86400, 0))::numeric\n  , 2) AS week_units_per_day\nFROM public.tshwane_electricity a\nLEFT JOIN LATERAL (\n  SELECT reading_date, cumulative_electricity_used\n  FROM public.tshwane_electricity\n  WHERE reading_date <= a.reading_date - INTERVAL '7 days'\n  ORDER BY reading_date DESC\n  LIMIT 1\n) b ON true\nWHERE $__timeFilter(a.reading_date)\nORDER BY a.reading_date",
          "refId": "A",
          "table": "tshwane_electricity"
        },
        {
          "dataset": "LOOTS",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "P7D58F15E2B4BC203"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH intervals AS (\n  SELECT\n    updated,\n    purchase_power,\n    EXTRACT(EPOCH FROM (updated - LAG(updated) OVER (ORDER BY updated))) / 3600 AS hours\n  FROM public.loots_inverter\n),\ndaily AS (\n  SELECT\n    DATE(updated) AS day,\n    ROUND(SUM(hours * purchase_power) / 1000 ::numeric, 2) AS daily_purchased_kwh\n  FROM intervals\n  WHERE $__timeFilter(updated)\n  GROUP BY DATE(updated)\n)\nSELECT\n  day AS time,\n  ROUND(AVG(daily_purchased_kwh) OVER (\n    ORDER BY day\n    ROWS BETWEEN 6 PRECEDING AND CURRENT ROW\n  )::numeric, 2) AS purchased_7day_avg_kwh\nFROM daily\nORDER BY day",
          "refId": "B",
          "table": "loots_inverter"
        }
      ],
      "title": "Weekly Electricity Usage vs Daily Grid Purchased (kWh/day)",
      "type": "timeseries"
